# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-anon-key>

# Direct Postgres connection (Project Settings → Database → Connection string).
# Used by `npm run db:assert` and the /tests/critical suite. Must be the direct
# 5432 connection (not the pooler) so SET ROLE / SET CONSTRAINTS behave.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Anthropic — needed from build Step 5, not Step 1.
ANTHROPIC_API_KEY=
