{
  "name": "sp-strategy-journey",
  "version": "0.1.0",
  "private": true,
  "description": "Strategy Journey Platform — Consultant Workspace prototype",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
