    "deck:render": "tsx scripts/render-deck.ts",
    "eval": "tsx scripts/run-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.65.0",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.58.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.544.0",
    "mammoth": "1.12.1",
    "next": "^15.5.23",
    "pg": "8.13.3",
    "pptxgenjs": "4.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "2.6.0",
    "unpdf": "1.8.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.11.11",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "dotenv": "16.4.7",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "postcss": "8.5.6",
    "supabase": "2.40.7",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
